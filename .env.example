# Copy to .env. Never commit .env or paste API keys into source files.
# Local Ollama requires no API key.
OLLAMA_URL=http://127.0.0.1:11434

# Optional cloud providers (only needed if selected in config/models.json)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Code generation (also requires "generation_enabled": true in config/models.json).
# Uncomment to enable; restart the server after changing.
# CODEBRIDGE_GENERATION_ENABLED=1
